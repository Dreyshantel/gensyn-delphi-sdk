# Copy this file to .env in the repo root and fill it in.
# .env is git-ignored. Never commit real keys.

# --- Competition and Delphi API -------------------------------------------
COMPETITION_SITE_URL=https://<competition site>
DELPHI_API_URL=https://<Delphi app domain>/v1
DELPHI_API_ACCESS_KEY=

# Shown on the leaderboard and in your submissions (1-64 printable ASCII).
AGENT_ID=DelphiLens
# Defaults to LLM_MODEL when empty.
AGENT_MODEL=
AGENT_HARNESS=gensyn-delphi-sdk/examples/evidence-starter

# Set to the terms version ONLY after you have read the terms URL the agent prints.
ACCEPT_TERMS=

# --- Mode ------------------------------------------------------------------
# mine   = discover -> research -> extract -> check -> (maybe) submit
# status = refresh verdicts and print the submission history
AGENT_MODE=mine

# dry-run (default, never submits) | approve (y/n per note) | auto
SUBMIT_MODE=dry-run

# --- Free LLM (any OpenAI-compatible API) -----------------------------------
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   (use a model ID ending in :free)
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Pacing for free tiers: gap between calls and a hard cap per run.
LLM_MIN_INTERVAL_MS=3500
# Per run: about 1 query-planning call per market + 1 call per article checked.
LLM_MAX_CALLS=30
# 1 = let the LLM read each market's criteria and suggest searches (one call per market), 0 = rule-based only.
LLM_QUERY_PLANNER=1
# Token pacing. Groq's free tier allows 8000 tokens/minute on openai/gpt-oss-120b; keep a margin.
LLM_TOKENS_PER_MINUTE=7000
# Output cap per call (reasoning included).
LLM_MAX_COMPLETION_TOKENS=2048
# Reasoning models (gpt-oss on Groq): low | medium | high. Empty = provider default.
LLM_REASONING_EFFORT=

# --- Research --------------------------------------------------------------
# Optional. Free tier: https://tavily.com. Google News is always used.
TAVILY_API_KEY=
# Google News edition (default US/English).
GOOGLE_NEWS_HL=en-US
GOOGLE_NEWS_GL=US
# Optional JSON object: {"0xMarketAddress": "resolution criteria text"}.
# Without it, each market's question is used as its criteria.
RESOLUTION_CRITERIA_JSON=

# --- Limits ----------------------------------------------------------------
MAX_MARKETS=5
MAX_ARTICLES_PER_MARKET=3
MAX_SUBMISSIONS=5
MIN_CONFIDENCE=0.6
HISTORY_PATH=.delphi-agent/submissions.json
